<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoRootContainer"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <VideoView
        android:layout_gravity="center"
        android:id="@+id/nativeVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/videoLoadingProgress"
        android:visibility="visible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/topBarOverlay"
        android:background="@drawable/vid_grad_top"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/btnVideoBack"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_video_back"
            android:contentDescription="Back"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/tvVideoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageButton
            android:id="@+id/btnVideoShare"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_video_share"
            android:contentDescription="Share"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/bottomControlsOverlay"
        android:background="@drawable/vid_grad_bot"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_video_play"
            android:contentDescription="Play/Pause"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#cccccc"
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_marginStart="4dp"/>
        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="1000"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:progressTint="#ffffff"
            android:progressBackgroundTint="#55ffffff"
            android:thumbTint="#ffffff"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#cccccc"
            android:id="@+id/tvTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnSpeed"
            android:background="@drawable/vid_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="44dp"
            android:text="1x"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"/>
        <ImageButton
            android:id="@+id/btnFullscreen"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_video_fullscreen"
            android:contentDescription="Fullscreen"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvHint"
        android:background="@drawable/vid_chip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"/>
</FrameLayout>
